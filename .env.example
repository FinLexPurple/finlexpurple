# Active language-model provider: ollama, anthropic, openai, openrouter, or gemini.
LLM_PROVIDER=ollama

# Ollama model name; select a model during setup.
OLLAMA_MODEL=
# Ollama server URL.
OLLAMA_HOST=http://localhost:11434

# API key for the selected Anthropic provider.
ANTHROPIC_API_KEY=
# API key for the selected OpenAI provider.
OPENAI_API_KEY=
# API key for the selected OpenRouter provider.
OPENROUTER_API_KEY=
# API key for the selected Gemini provider.
GEMINI_API_KEY=

# Require approval before potentially state-changing exploit attempts.
REQUIRE_HUMAN_APPROVAL=true
# Enable optional, allow-listed telemetry (off by default).
TELEMETRY_ENABLED=false
