# Active language-model provider: ollama, anthropic, openai, openrouter, or gemini.
LLM_PROVIDER=ollama

# Ollama model name; select a model during setup.
OLLAMA_MODEL=
# Model tier selected by setup: cloud, local-30b, local-8b-hybrid, or local-3b-triage.
MODEL_TIER=
# Ollama server URL.
OLLAMA_HOST=http://localhost:11434

# Default model names for cloud providers; change these to another model
# supported by your account/provider if desired.
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-6.1-sol
OPENROUTER_MODEL=openai/gpt-6-luna
GEMINI_MODEL=gemini-3.8-flash

# Optional cloud provider for the local-8b-hybrid tier. This stores fallback
# configuration only; automatic request routing is not implemented yet.
FALLBACK_LLM_PROVIDER=

# API key for the selected Anthropic provider.
ANTHROPIC_API_KEY=
# API key for the selected OpenAI provider.
OPENAI_API_KEY=
# API key for the selected OpenRouter provider.
OPENROUTER_API_KEY=
# API key for the selected Gemini provider.
GEMINI_API_KEY=

# Require approval before potentially state-changing exploit attempts.
REQUIRE_HUMAN_APPROVAL=true
# Enable optional, allow-listed telemetry (off by default).
TELEMETRY_ENABLED=false
