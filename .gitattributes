# The baseline intelligence pack is verified byte-for-byte against a pinned
# sha256 (intel/baseline.py BASELINE_SHA256). Force it to stay LF on every
# platform so a Windows checkout (core.autocrlf=true) cannot rewrite it to CRLF
# and break that hash. Scoped to the pack data only — no repo-wide normalization.
src/finlexpurple/intel/baseline/pack.json text eol=lf

# Evidence-bundle golden vectors (Unit 1.1): verify-bundle is a forever contract
# and these are verified byte-for-byte in CI (v1 hashes the exact stored bytes;
# v0 recomputes a canonical hash). Force LF so a Windows checkout cannot rewrite
# them to CRLF and break verification. Scoped to the golden files only.
tests/finlexpurple/evidence/golden/*.bundle.json text eol=lf

# The published report.json JSON Schema (Unit 1.3) is a frozen public contract
# loaded verbatim in CI. Keep it LF on every platform for stable cross-OS reads.
src/finlexpurple/reporting/report.schema.json text eol=lf
